    "Net PnL": "pnlNet",
    "Return": "returnFraction",
    "Commission": "feeTotal",
    "Favorable excursion": "excursion.mfeMoney/mfeFraction",
    "Adverse excursion": "excursion.maeMoney/maeFraction",
